{
  "info": {
    "name": "Beleza Ecosystem - Agent IA",
    "description": "API do Agente Inteligente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agent Info",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/ia",
          "host": ["{{base_url}}"],
          "path": ["api", "ia"]
        },
        "description": "Obter informações sobre o agente"
      }
    },
    {
      "name": "Agent Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/ia/health",
          "host": ["{{base_url}}"],
          "path": ["api", "ia", "health"]
        },
        "description": "Verificar se OpenAI está acessível"
      }
    },
    {
      "name": "Message - Aumentar Faturamento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Como eu aumento meu faturamento em 30%?\",\n  \"establishmentId\": \"{{establishment_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ia",
          "host": ["{{base_url}}"],
          "path": ["api", "ia"]
        },
        "description": "Enviar mensagem de estratégia ao agente"
      }
    },
    {
