      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Quem são meus clientes inativos? Como posso reativá-los?\",\n  \"establishmentId\": \"{{establishment_id}}\"\n}"
