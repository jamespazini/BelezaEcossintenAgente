      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Agende uma consulta para João Silva em 2026-05-10 às 14:00 para corte de cabelo\",\n  \"establishmentId\": \"{{establishment_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ia",
          "host": ["{{base_url}}"],
          "path": ["api", "ia"]
        },
        "description": "Criar um agendamento através do agente"
      }
    },
    {
      "name": "Message - Gerar Relatório",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Preciso de um relatório detalhado dos últimos 30 dias\",\n  \"establishmentId\": \"{{establishment_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ia",
          "host": ["{{base_url}}"],
          "path": ["api", "ia"]
        },
        "description": "Solicitar um relatório de desempenho"
      }
    },
    {
      "name": "Message - Criar Anúncio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
