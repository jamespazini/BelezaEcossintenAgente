# OpenAI Configuration - Intelligent Agent
# Beleza Ecosystem - AI Agent

# ============================================================
# OpenAI API Configuration
# ============================================================

# OpenAI API Key (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_aqui

# OpenAI Model
# Recommended: gpt-4o-mini (cost-effective, powerful)
# Options: gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Agent Configuration
# ============================================================

# Agent Name
AGENT_NAME="Agente Beleza Ecosystem"

# Agent Language
AGENT_LANGUAGE=pt-BR

# Enable Agent Debug Mode (logs everything)
AGENT_DEBUG=false

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================

# Database URL or individual connection params
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beleza_ecosystem
DB_USER=postgres
DB_PASSWORD=yourpassword

# ============================================================
# Server Configuration
# ============================================================

NODE_ENV=development
PORT=3000

# ============================================================
# CORS & Security
# ============================================================

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================================
# WhatsApp Integration (Mock for now)
# ============================================================

# TODO: Configure when integrating real WhatsApp API
# WHATSAPP_API_KEY=
# WHATSAPP_API_URL=
# WHATSAPP_PHONE_NUMBER=
